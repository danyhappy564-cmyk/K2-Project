<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cluade_For_spt의 docs/kb/00-environment.md·05-project-structure.md에서
    가져온, 다른 프로젝트에서 실제로 dotnet build/restore까지 검증된 표준
    구성이다(2026-09-21). 이 저장소에는 원래 K2.Server.csproj가 없었다 —
    .gitignore의 "*.csproj"가 Unity 자동생성분과 이 손으로 쓴 파일을 같이
    무시해서 한 번도 git에 커밋된 적이 없었고, 로컬 PC에도 실제로 없었다
    (2026-09-21 사용자 리포트로 확인). 이 파일이 그 복원본이다.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>K2Project</RootNamespace>
    <AssemblyName>K2.Server</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 패키지 이름은 SPTushonka.* 인데 어셈블리/네임스페이스는 여전히
         SPTarkov.* 다(docs/kb/00-environment.md). 정확한 패치 버전을 모를 때는
         "4.1.*"처럼 마이너 floating을 쓰는 게 4.1.5로 고정하는 것보다 안전하다
         — 이 프로젝트는 4.1.6을 대상으로 하므로(README 참고) 4.1 안에서
         자동으로 최신을 받는다. 만약 이 버전으로 복원이 안 되면
         Cluade_For_spt/docs/kb/00-environment.md의 예시(4.1.5 고정)로
         낮춰서 시도할 것. -->
    <PackageReference Include="SPTushonka.Common" Version="4.1.*" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.*" />
    <PackageReference Include="SPTushonka.Reflection" Version="4.1.*" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.*" />
  </ItemGroup>

  <!-- 2026-09-21: Release로 빌드할 때마다 SPT 설치 폴더로 바로 배포한다
       (SAIN 등 다른 모드들이 쓰는 방식 — 매번 수동으로 파일 복사/스크립트
       실행 안 해도 됨). 기본 경로는 PROJECT-RULES.md 1-1절 표준값이고,
       실제 경로가 다르면 SPT_ROOT 환경변수로 덮어쓴다: set SPT_ROOT=... -->
  <PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == '' And '$(SPT_ROOT)' != ''">$(SPT_ROOT)</SptRoot>
    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.1</SptRoot>
    <SptModDir>$(SptRoot)\SPT_Runtime\user\mods\K2-Project</SptModDir>
  </PropertyGroup>

  <Target Name="DeployToSpt" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <K2DataFiles Include="$(MSBuildProjectDirectory)\data\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(SptModDir)" Condition="!Exists('$(SptModDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptModDir)" />
    <Copy SourceFiles="@(K2DataFiles)" DestinationFolder="$(SptModDir)\data\%(RecursiveDir)" Condition="Exists('$(MSBuildProjectDirectory)\data')" />
    <Message Importance="high" Text="[K2] 서버 모드 배포 완료: $(SptModDir)" />
  </Target>

</Project>
