<?xml version="1.0" encoding="utf-8"?>
<!--
  2026-09-21: 원래 <clear/>만 있고 소스가 하나도 없었다 — SPTushonka.* 패키지도
  이 설정으로는 못 받는다(Cluade_For_spt/docs/kb/03-verification.md 3.1.2절에서
  다른 프로젝트는 실제로 dotnet restore가 됐다고 확인했으므로, 기본 nuget.org로
  받아지는 게 맞다). <clear/>는 유지하고(회사/환경별 다른 소스가 끼어드는 걸
  막는 용도) nuget.org만 명시로 추가했다.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
